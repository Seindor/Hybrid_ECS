{
  "name": "Test",
  "globIgnorePaths": ["**/*.spec.luau", "**/*.data.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "$path": "out/shared",
      "RbxPackages": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "$path": "roblox_packages"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "$path": "out/server",
      "ServerRbxPackages": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "$path": "roblox_server_packages"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "out/client",
      "$ignoreUnknownInstances": true
    }
  }
}